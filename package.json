{
  "name": "open-side-protocol",
  "version": "1.0.0",
  "description": "Hardware-agnostic, zero-dependency decentralized P2P standby compute grid (Single Compute Sea protocol) pooling idle hardware for distributed task execution.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "daemon": "node src/daemon.js",
    "gateway": "node -e \"const { OpenSideGateway } = require('./src/index'); new OpenSideGateway().start();\"",
    "test": "node --test",
    "test:ci": "node --test --test-concurrency=1"
  },
  "keywords": [
    "grid-computing",
    "distributed-systems",
    "edge-computing",
    "p2p-mesh",
    "standby-compute",
    "zero-trust-sandbox",
    "single-compute-sea",
    "ecdh",
    "hkdf-sha512",
    "proof-of-compute",
    "kademlia-dht",
    "webassembly",
    "wasm",
    "ai-gateway"
  ],
  "author": "pc1209920-coder",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
